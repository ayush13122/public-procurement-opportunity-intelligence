table assam_procurement_cleaned
	lineageTag: 90edcedb-b503-41ba-9d2b-2e7537edfb47

	measure 'Total Tenders (Numeric)' = DISTINCTCOUNT('assam_procurement_cleaned'[ocid])
		formatString: #,##0
		displayFolder: 01 | Core KPIs
		lineageTag: 643fa5b6-6d0f-4fe1-ab5b-a7f4211ba8b4

	measure 'Total Tenders' = FORMAT([Total Tenders (Numeric)], "#,##0")
		displayFolder: 01 | Display KPIs
		lineageTag: fed7de37-8081-4db4-9d48-d213ccc2d7a9

	measure 'Unique Buyers (Numeric)' = DISTINCTCOUNT('assam_procurement_cleaned'[buyer/name])
		formatString: #,##0
		displayFolder: 01 | Core KPIs
		lineageTag: bda67e49-5732-46f6-a75e-09782f441ced

	measure 'Unique Buyers' = FORMAT([Unique Buyers (Numeric)], "#,##0")
		displayFolder: 01 | Display KPIs
		lineageTag: 5e8286bd-4421-4ebc-b69f-5ea0e6a5ddf9

	measure 'Positive Value Records (Numeric)' = CALCULATE(COUNTROWS('assam_procurement_cleaned'), 'assam_procurement_cleaned'[tender/value/amount] > 0)
		formatString: #,##0
		displayFolder: 01 | Core KPIs
		lineageTag: 2dd51585-86e2-4cab-b232-946b50c631d2

	measure 'Positive Value Records' = FORMAT([Positive Value Records (Numeric)], "#,##0")
		displayFolder: 01 | Display KPIs
		lineageTag: 57bc71c1-0555-4cbd-aa51-e497a0cf0247

	measure 'Zero Value Records (Numeric)' = CALCULATE(COUNTROWS('assam_procurement_cleaned'), 'assam_procurement_cleaned'[tender/value/amount] = 0)
		formatString: #,##0
		displayFolder: 01 | Core KPIs
		lineageTag: 1e957aaa-7fc0-475d-9d06-b26fae155e2f

	measure 'Zero Value Records' = FORMAT([Zero Value Records (Numeric)], "#,##0")
		displayFolder: 01 | Display KPIs
		lineageTag: 0f9442fb-03f3-41eb-bdef-821b4ce2b2be

	measure 'Missing Value Records (Numeric)' = CALCULATE(COUNTROWS('assam_procurement_cleaned'), ISBLANK('assam_procurement_cleaned'[tender/value/amount]))
		formatString: #,##0
		displayFolder: 01 | Core KPIs
		lineageTag: d1cd7d78-591a-4647-995b-a2346a1e2d3c

	measure 'Missing Tender Values' = FORMAT([Missing Value Records (Numeric)], "#,##0")
		displayFolder: 01 | Display KPIs
		lineageTag: 5cb8f6fd-c1db-400c-a538-c6a579541a93

	measure 'Recorded Tender Value (Numeric)' = SUM('assam_procurement_cleaned'[tender/value/amount])
		formatString: #,##0
		displayFolder: 02 | Tender Value
		lineageTag: 110983e6-1aed-4d8a-9323-e9ac11558b8b

	measure 'Total Value (T units)' = FORMAT(DIVIDE([Recorded Tender Value (Numeric)], 1000000000000), "0.00") & "T"
		displayFolder: 02 | Tender Value
		lineageTag: 58b2e75b-edc0-46b7-9241-996812aa0b75

	measure 'Average Recorded Tender Value (Numeric)' = AVERAGE('assam_procurement_cleaned'[tender/value/amount])
		formatString: #,##0.00
		displayFolder: 02 | Tender Value
		lineageTag: 6a6d2ca2-4fc6-44b0-a9ad-8a16972fb526

	measure 'Average Tender Value (M source units)' = FORMAT(DIVIDE([Average Recorded Tender Value (Numeric)], 1000000), "0.00") & "M"
		displayFolder: 02 | Tender Value
		lineageTag: e1455cc0-6d74-4328-a689-8994ccf6affc

	measure 'Median Positive Tender Value (Numeric)' = MEDIANX(FILTER('assam_procurement_cleaned', 'assam_procurement_cleaned'[tender/value/amount] > 0), 'assam_procurement_cleaned'[tender/value/amount])
		formatString: #,##0.00
		displayFolder: 02 | Tender Value
		lineageTag: 2a23c3bc-b677-4477-9c0d-bd53af741074

	measure 'Median Positive (M units)' = FORMAT(DIVIDE([Median Positive Tender Value (Numeric)], 1000000), "0.00") & "M"
		displayFolder: 02 | Tender Value
		lineageTag: 0b78fbc7-097a-4dab-b374-2218cea628f9

	measure 'Average Positive Tender Value (Numeric)' = AVERAGEX(FILTER('assam_procurement_cleaned', 'assam_procurement_cleaned'[tender/value/amount] > 0), 'assam_procurement_cleaned'[tender/value/amount])
		formatString: #,##0.00
		displayFolder: 02 | Tender Value
		lineageTag: 69f941c1-ad9a-46da-a298-95c9ac1065c7

	measure 'Tender Value Coverage %' = DIVIDE([Positive Value Records (Numeric)] + [Zero Value Records (Numeric)], [Total Tenders (Numeric)])
		formatString: 0.00%
		displayFolder: 02 | Tender Value
		lineageTag: 2c211652-3290-4bf0-9f40-a5fdc3fbef08

	measure 'Positive Value Share %' = DIVIDE([Positive Value Records (Numeric)], [Total Tenders (Numeric)])
		formatString: 0.00%
		displayFolder: 02 | Tender Value
		lineageTag: 6d118590-71a2-4a55-bad6-6ffdab3a0e19

	measure 'Average Tenderers' = AVERAGE('assam_procurement_cleaned'[tender/numberOfTenderers])
		formatString: #,##0.00
		displayFolder: 03 | Procurement Metrics
		lineageTag: 509d86d8-29e4-46bc-bca2-1aae3dad3632

	measure 'Average Tender Period Days' = AVERAGE('assam_procurement_cleaned'[tender/tenderPeriod/durationInDays])
		formatString: #,##0.0
		displayFolder: 03 | Procurement Metrics
		lineageTag: 2e806224-9d77-4c55-aae7-925247f87684

	measure 'Holdout Accuracy' = 0.9335
		formatString: 0.00%
		displayFolder: 04 | Historical ML Model
		lineageTag: d45a53ef-69cb-4e94-9081-59dbaadaad05

	measure 'Macro F1' = 0.8673
		formatString: 0.00%
		displayFolder: 04 | Historical ML Model
		lineageTag: 8e043046-c583-451c-aabd-b0651d382646

	measure 'Weighted F1' = 0.9366
		formatString: 0.00%
		displayFolder: 04 | Historical ML Model
		lineageTag: 83e52015-08e6-4ddb-a14d-4655c2f3976c

	measure 'Balanced Accuracy' = 0.9155
		formatString: 0.00%
		displayFolder: 04 | Historical ML Model
		lineageTag: 03569730-79d4-4112-95a1-e646bad8abe6

